generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ────────────────────────────────────────────

enum UserRole {
  ADMIN
  DEVELOPER
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  company       String?
  role          UserRole  @default(DEVELOPER)
  avatarUrl     String?
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  apiKeys       ApiKey[]
  subscriptions Subscription[]
  usageLogs     UsageLog[]
  invoices      Invoice[]
  webhookEndpoints WebhookEndpoint[]

  @@map("users")
}

// ─── API Products ────────────────────────────────────────────

enum ApiStatus {
  DRAFT
  ACTIVE
  DEPRECATED
  RETIRED
}

model ApiProduct {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  description   String
  version       String    @default("1.0.0")
  baseUrl       String    // upstream URL to proxy to
  basePath      String    // gateway path prefix e.g. /weather
  status        ApiStatus @default(DRAFT)
  documentation String?   @db.Text // markdown docs
  openApiSpec   Json?     // OpenAPI 3.0 spec
  logoUrl       String?
  tags          String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  plans         Plan[]
  endpoints     ApiEndpoint[]
  usageLogs     UsageLog[]
  analyticsAgg  AnalyticsAggregation[]

  @@map("api_products")
}

model ApiEndpoint {
  id           String      @id @default(uuid())
  apiProductId String
  method       String      // GET, POST, etc.
  path         String      // e.g. /forecast/{city}
  description  String?
  isPublic     Boolean     @default(true)
  createdAt    DateTime    @default(now())

  apiProduct   ApiProduct  @relation(fields: [apiProductId], references: [id], onDelete: Cascade)
  usageLogs    UsageLog[]

  @@unique([apiProductId, method, path])
  @@map("api_endpoints")
}

// ─── Plans & Pricing ────────────────────────────────────────

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PlanType {
  FREE
  TIERED
  PAY_AS_YOU_GO
  ENTERPRISE
}

model Plan {
  id              String        @id @default(uuid())
  apiProductId    String
  name            String        // e.g. "Starter", "Pro", "Enterprise"
  slug            String        @unique
  description     String?
  planType        PlanType      @default(TIERED)
  price           Decimal       @db.Decimal(10,2) // monthly price
  yearlyPrice     Decimal?      @db.Decimal(10,2)
  requestLimit    Int           // requests per billing cycle, -1 = unlimited
  rateLimit       Int           // requests per minute
  burstLimit      Int           @default(0)  // extra burst allowance
  overagePrice    Decimal?      @db.Decimal(10,6) // price per extra request
  features        Json?         // { "feature_name": true/false }
  isActive        Boolean       @default(true)
  sortOrder       Int           @default(0)
  stripePriceId   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  apiProduct      ApiProduct    @relation(fields: [apiProductId], references: [id], onDelete: Cascade)
  subscriptions   Subscription[]

  @@map("plans")
}

// ─── API Keys ───────────────────────────────────────────────

model ApiKey {
  id             String    @id @default(uuid())
  userId         String
  keyHash        String    @unique   // bcrypt hash of the key
  keyPrefix      String              // first 8 chars for identification
  name           String    @default("Default")
  isActive       Boolean   @default(true)
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageLogs      UsageLog[]

  @@map("api_keys")
}

// ─── Subscriptions ──────────────────────────────────────────

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  TRIAL
}

model Subscription {
  id                 String              @id @default(uuid())
  userId             String
  planId             String
  status             SubscriptionStatus  @default(ACTIVE)
  billingCycle       BillingCycle        @default(MONTHLY)
  currentPeriodStart DateTime            @default(now())
  currentPeriodEnd   DateTime
  requestsUsed       Int                 @default(0)
  stripeSubId        String?
  cancelledAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               Plan                @relation(fields: [planId], references: [id])
  invoices           Invoice[]

  @@unique([userId, planId])
  @@map("subscriptions")
}

// ─── Usage Tracking ─────────────────────────────────────────

model UsageLog {
  id             String       @id @default(uuid())
  userId         String
  apiProductId   String
  apiKeyId       String?
  endpointId     String?
  method         String
  path           String
  statusCode     Int
  responseTimeMs Int
  requestSize    Int          @default(0)
  responseSize   Int          @default(0)
  ipAddress      String?
  userAgent      String?
  timestamp      DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiProduct     ApiProduct   @relation(fields: [apiProductId], references: [id], onDelete: Cascade)
  apiKey         ApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  endpoint       ApiEndpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)

  @@index([userId, timestamp])
  @@index([apiProductId, timestamp])
  @@index([timestamp])
  @@map("usage_logs")
}

// ─── Analytics Aggregations ─────────────────────────────────

enum AggregationPeriod {
  HOURLY
  DAILY
  MONTHLY
}

model AnalyticsAggregation {
  id             String              @id @default(uuid())
  apiProductId   String
  period         AggregationPeriod
  periodStart    DateTime
  totalRequests  Int                 @default(0)
  successCount   Int                 @default(0)
  errorCount     Int                 @default(0)
  avgResponseMs  Float               @default(0)
  p95ResponseMs  Float               @default(0)
  p99ResponseMs  Float               @default(0)
  uniqueUsers    Int                 @default(0)
  totalBandwidth BigInt              @default(0)

  apiProduct     ApiProduct          @relation(fields: [apiProductId], references: [id], onDelete: Cascade)

  @@unique([apiProductId, period, periodStart])
  @@index([periodStart])
  @@map("analytics_aggregations")
}

// ─── Billing & Invoices ─────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  FAILED
  VOID
}

model Invoice {
  id               String         @id @default(uuid())
  userId           String
  subscriptionId   String
  amount           Decimal        @db.Decimal(10,2)
  currency         String         @default("usd")
  status           InvoiceStatus  @default(DRAFT)
  periodStart      DateTime
  periodEnd        DateTime
  requestCount     Int            @default(0)
  overageCount     Int            @default(0)
  overageAmount    Decimal        @default(0) @db.Decimal(10,2)
  stripeInvoiceId  String?
  paidAt           DateTime?
  dueDate          DateTime
  createdAt        DateTime       @default(now())

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription     Subscription   @relation(fields: [subscriptionId], references: [id])
  lineItems        InvoiceLineItem[]

  @@map("invoices")
}

model InvoiceLineItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10,6)
  amount      Decimal  @db.Decimal(10,2)

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_line_items")
}

// ─── Webhooks ───────────────────────────────────────────────

model WebhookEndpoint {
  id        String   @id @default(uuid())
  userId    String
  url       String
  events    String[] // e.g. ["usage.limit_reached", "invoice.created"]
  secret    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("webhook_endpoints")
}
